      },
      {
        "id": "esp32-c6-devkitc-1",
        "name": "ESP32-C6-DevKitC-1",
        "chip": "ESP32-C6",
        "environment": "scanner--esp32-c6"
      }
    ],
    "hardware": "Board only",
